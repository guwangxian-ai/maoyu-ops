# 环境配置
ENVIRONMENT=development

# 日志配置
LOG_LEVEL=INFO

# SQL 日志开关：true=打印每条执行的完整 SQL（默认，便于开发/Docker 排查）；
# 高并发生产环境如需降低开销可设为 false
SQL_ECHO=true

# IM Token 缓存基础 TTL 随机区间（小时）；之后追加 1~5 小时秒级随机偏移
# TOKEN_CACHE_TTL_MIN_HOURS=5
# TOKEN_CACHE_TTL_MAX_HOURS=10

# 监听地址：:: 同时监听 IPv4 和 IPv6（dual-stack），0.0.0.0 仅监听 IPv4
# HOST=::

# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=xianyu_auto_reply

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_POOL_SIZE=800
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=3
REDIS_SOCKET_KEEPALIVE=true
REDIS_SOCKET_KEEPALIVE_IDLE=60
REDIS_SOCKET_KEEPALIVE_INTERVAL=10
REDIS_SOCKET_KEEPALIVE_COUNT=3
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_PROTOCOL=2
REDIS_STARTUP_MAX_RETRIES=5
REDIS_STARTUP_RETRY_BASE_DELAY=1
REDIS_STARTUP_RETRY_CAP_DELAY=10

# Backend-Web服务配置
BACKEND_WEB_PORT=8089

# JWT配置
# 说明：JWT_SECRET_KEY 由数据库统一托管（首次启动自动生成并持久化到 xy_system_settings），无需在此配置
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 服务间 /internal API 共享令牌（可选；留空时首次启动自动生成并保存到数据库）
INTERNAL_API_TOKEN=

# CORS配置（* 表示允许所有来源，生产环境建议指定具体域名）
CORS_ORIGINS=*

# 服务间通信URL
WEBSOCKET_SERVICE_URL=http://127.0.0.1:8090
SCHEDULER_SERVICE_URL=http://127.0.0.1:8091

# 分销卡券上游服务基址（「分销卡券」页面通过该上游卡券系统提货）
CARD_DOCK_BASE_URL=http://backend.zhinianboke.com

# 外部 API 密钥管理服务（个人设置「对接卡密秘钥」一键创建密钥）
# 基址复用 CARD_DOCK_BASE_URL，仅需配置创建密钥的鉴权 key（禁止写死）
EXTERNAL_API_KEY=zhinian_bk

# 远程官方服务基址（仪表盘广告、系统公告等 = 本地内容 + 远程官方内容，与桌面版同源）
REMOTE_OFFICIAL_BASE_URL=https://xy.zhinianboke.com
# 是否启用远程官方广告合并展示（官方服务器自身部署时建议设为 false，避免重复展示自己的广告）
ENABLE_REMOTE_ADS=true
# 是否启用远程官方公告合并展示（官方服务器自身部署时建议设为 false，避免重复展示自己的公告）
ENABLE_REMOTE_ANNOUNCEMENTS=true
# 是否启用远程官方弹窗公告合并展示（官方服务器自身部署时建议设为 false，避免重复展示自己的弹窗公告）
ENABLE_REMOTE_POPUP_ANNOUNCEMENTS=true

# 静态文件目录（共享）
STATIC_DIR=static

# 数据库备份文件目录（与 scheduler 共享，scheduler 写入、backend-web 读取下载）
BACKUP_DIR=backups

# 夸克网盘 Skill 授权状态目录（每个后台用户独立存储；切勿置于 STATIC_DIR）
QUARK_AUTH_DIR=data/quark-auth
# 只缩短固定官方 CLI 的读取诊断收尾；设为 false 可恢复原始等待。
QUARK_FAST_READ=true

# 前端公网访问地址（用于生成前端页面分享链接、「同意后发货」提货页地址）
# 公网部署必须改为买家可访问的公网地址（例如 https://你的域名），否则提货链接买家打不开
FRONTEND_PUBLIC_URL=http://127.0.0.1:9000

# Backend-Web服务的公网访问地址（用于生成文件URL）
BACKEND_WEB_PUBLIC_URL=http://127.0.0.1:8089
AUTO_START_CRAWL_JOBS=false

# 百度网盘：官方 Skill + bdpan CLI，账号凭证按本站用户保存至私有目录
BAIDU_AUTH_DIR=data/baidu-auth
# 官方 Skill 的 bdpan 二进制完整路径。默认使用项目 data/local-dev/runtime/bdpan/bdpan。
BAIDU_BDPAN_BIN=
BAIDU_MAX_DOWNLOAD_BYTES=268435456
# 旧 OpenAPI 实现的兼容字段；当前官方 Skill 路由不使用以下值
BAIDU_CLIENT_ID=
BAIDU_CLIENT_SECRET=
# 单次上传总大小，默认 1 GiB；最多 100 个文件
BAIDU_MAX_UPLOAD_BYTES=1073741824

# 多网盘同步资料：私有暂存目录（默认项目 data/cloud-assets），单份默认 256 MiB
CLOUD_ASSET_DIR=
CLOUD_ASSET_MAX_BYTES=268435456

# MCP：默认仅允许本机访问；公网部署需按实际 HTTPS 域名配置，不能使用通配全放行。
# MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
# MCP_FILE_DIR=/absolute/private/path/mcp-files
# 公开接入说明的可信地址；部署到子路径时保留完整路径，远程必须使用 HTTPS。
MCP_PUBLIC_BASE_URL=http://127.0.0.1:9000
# 未设置 MCP_FILE_DIR 时使用项目根目录下 data/mcp-files，不能放在 STATIC_DIR。

# 数据库连接池配置（账号数量较大时可调优；不配置则使用代码内置默认值）
# 重要：DB_POOL_SIZE + DB_MAX_OVERFLOW 不应超过 MySQL 的 max_connections，
# 否则连接池打满后会触发 MySQL 的 "Too many connections"。
DB_POOL_SIZE=40          # 常驻连接数（API 服务）
DB_MAX_OVERFLOW=60       # 溢出连接数（峰值 = DB_POOL_SIZE + DB_MAX_OVERFLOW = 100）
DB_POOL_TIMEOUT=30       # 从连接池获取连接的最长等待秒数
DB_POOL_RECYCLE=1800     # 连接回收时间（秒），防止 MySQL 断开陈旧连接
DB_POOL_PRE_PING=true    # 取连接前 ping，自动剔除失效连接
DB_POOL_USE_LIFO=true    # LIFO 复用最近连接，便于空闲连接被回收
DB_CONNECT_TIMEOUT=10    # 建立 TCP 连接的超时秒数，远程库不可达时快速失败
